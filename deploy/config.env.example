# aigw-claims-broker deployment settings. Copy to deploy/config.env and edit. No secrets in this file:
# the signing key is generated in the cluster by deploy.sh.

KUBE_CONTEXT=""                                  # kubectl context; empty = current
NAMESPACE="aigw-claims-broker"
REPLICAS="2"
IMAGE="node:22-alpine"                           # app code is mounted from a ConfigMap; or build the Dockerfile

# Public base URL of the broker (the `iss` of minted tokens). Clients call <BROKER_ISSUER>/token/exchange.
BROKER_ISSUER="https://aigw-broker.example.com"
BROKER_AUDIENCE="aigw"

# Exposure: "loadbalancer" (optionally pin LB_IP on MetalLB) or "clusterip" (put your own Ingress/TLS in front).
EXPOSE="loadbalancer"
LB_IP=""

# The broker policy (IdP issuer, claims to copy, required claims, gateway scopes). See examples/.
BROKER_CONFIG_FILE="examples/broker-config.example.json"
